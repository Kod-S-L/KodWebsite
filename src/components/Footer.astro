---
const year = new Date().getFullYear();

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="KOD home">
        <span class="logo-bracket">[</span>KOD<span class="logo-bracket">]</span>
      </a>
      <p class="footer-tagline">Building tomorrow, together.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} class="footer-link">{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>&copy; {year} KOD Team. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem;
    flex-wrap: wrap;
  }

  .footer-logo {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-white);
    text-decoration: none;
    transition: color var(--transition);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .footer-logo:hover {
    color: var(--color-primary-light);
  }

  .logo-bracket {
    color: var(--color-primary);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: none;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: var(--color-primary-light);
  }

  .footer-bottom {
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
