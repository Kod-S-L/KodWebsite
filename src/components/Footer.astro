---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navLinks } from '../data/nav-links';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo size="sm" class="footer-logo" />
      <p class="footer-tagline">
        Web development, custom software and business automations — built to last.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <span class="footer-heading">Site</span>
      <ul>
        {navLinks.map(({ href, label }) => (
          <li><a href={href} class="footer-link">{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <span class="footer-heading">Contact</span>
      <a class="footer-link footer-link--prominent" href="mailto:hello@kodteam.dev">
        <Icon name="mail" size={16} /> hello@kodteam.dev
      </a>
      <a class="footer-link" href="/contact">Start a project</a>
    </div>
  </div>

  <div class="footer-bottom container">
    <p>&copy; {year} KOD Team. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 3rem;
  }

  .footer-brand {
    max-width: 32ch;
  }

  .footer-logo {
    margin-bottom: 0.75rem;
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .footer-heading {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.85rem;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: var(--color-primary-light);
  }

  .footer-link--prominent {
    color: var(--color-text);
    font-weight: 500;
  }

  .footer-bottom {
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
