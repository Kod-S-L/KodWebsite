---
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
  ariaLabel?: string;
}

const { projects, ariaLabel = 'Featured projects' } = Astro.props;
---

<div class="carousel" role="region" aria-roledescription="carousel" aria-label={ariaLabel}>
  <div class="carousel-controls">
    <button type="button" class="carousel-btn" data-direction="prev" aria-label="Previous projects">
      <Icon name="arrow-left" size={18} />
    </button>
    <button type="button" class="carousel-btn" data-direction="next" aria-label="Next projects">
      <Icon name="arrow-right" size={18} />
    </button>
  </div>

  <ul class="carousel-track" tabindex="0" aria-label="Featured projects scroll list">
    {projects.map((project) => (
      <li class="carousel-item">
        <ProjectCard project={project} variant="carousel" />
      </li>
    ))}
  </ul>
</div>

<style>
  .carousel {
    position: relative;
  }

  .carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .carousel-btn {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }

  .carousel-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary-light);
  }

  .carousel-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .carousel-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 0.25rem;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .carousel-track:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  /* Hide scrollbar visually but keep it functional. */
  .carousel-track::-webkit-scrollbar {
    height: 6px;
  }
  .carousel-track::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 9999px;
  }

  .carousel-item {
    display: flex;
    list-style: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function setupCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>('.carousel');

    carousels.forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('.carousel-track');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-direction="prev"]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-direction="next"]');
      if (!track) return;

      function step(direction: 1 | -1) {
        if (!track) return;
        const item = track.querySelector<HTMLElement>('.carousel-item');
        const itemWidth = item ? item.offsetWidth : track.clientWidth * 0.8;
        const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 20;
        track.scrollBy({ left: (itemWidth + gap) * direction, behavior: 'smooth' });
      }

      function updateButtons() {
        if (!track || !prev || !next) return;
        const max = track.scrollWidth - track.clientWidth - 1;
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= max;
      }

      prev?.addEventListener('click', () => step(-1));
      next?.addEventListener('click', () => step(1));

      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          step(1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          step(-1);
        }
      });

      track.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      updateButtons();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCarousels);
  } else {
    setupCarousels();
  }
</script>
