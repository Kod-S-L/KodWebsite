---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';

interface Block {
  icon: IconName;
  title: string;
  description: string;
}

const whatWeDo: Block[] = [
  {
    icon: 'layout',
    title: 'Websites that work',
    description:
      'Fast, accessible and easy to update. Built to convert visitors and keep maintenance simple.',
  },
  {
    icon: 'code',
    title: 'Custom software',
    description:
      'Tools shaped around how your team actually works — not generic platforms with extra friction.',
  },
  {
    icon: 'cog',
    title: 'Process automations',
    description:
      'Connect existing tools, remove repetitive tasks and free your team for higher-value work.',
  },
];

const howWeWork: Block[] = [
  {
    icon: 'check',
    title: '1. Listen first',
    description:
      'A short conversation to understand the goal, the constraints and what success looks like.',
  },
  {
    icon: 'check',
    title: '2. Propose clearly',
    description:
      'A concrete proposal with scope, timeline and price — written in plain language, no jargon.',
  },
  {
    icon: 'check',
    title: '3. Build in iterations',
    description:
      'We ship in small steps so you can review, adjust and avoid surprises at the end.',
  },
  {
    icon: 'check',
    title: '4. Support after launch',
    description:
      'Once live, we stay available for fixes, improvements and small evolutions over time.',
  },
];

const projectTypes: Block[] = [
  {
    icon: 'spark',
    title: 'Landing pages',
    description: 'Focused one-pagers built to communicate a single message and drive a single action.',
  },
  {
    icon: 'layout',
    title: 'Business websites',
    description: 'Multi-page presentation sites with services, contact forms and a clear visual identity.',
  },
  {
    icon: 'code',
    title: 'Internal tools',
    description: 'Dashboards and back-office apps that replace messy spreadsheets and manual processes.',
  },
  {
    icon: 'wrench',
    title: 'Take over existing sites',
    description: 'We pick up websites or apps left mid-build, fix what is broken and bring them up to standard.',
  },
];

const reasons: Block[] = [
  {
    icon: 'bolt',
    title: 'Direct communication',
    description:
      'You talk to the people building your project. No layers, no slow middlemen.',
  },
  {
    icon: 'shield',
    title: 'Honest scope',
    description:
      'We say what is realistic. If something will not fit the budget or timeline, we tell you up front.',
  },
  {
    icon: 'spark',
    title: 'Built to last',
    description:
      'Clean, maintainable code so the next change — by us or anyone else — stays cheap and safe.',
  },
];
---

<BaseLayout
  title="About"
  description="KOD is a small studio building fast, reliable websites, custom software and business automations for teams that want to grow."
>
  <PageHeader
    label="About us"
    title="A small studio,"
    highlight="serious work"
    description="KOD helps small and medium businesses move forward with the right digital tools — from a clean website to a custom internal application."
  />

  <!-- What we do -->
  <section class="section">
    <div class="container">
      <span class="section-label">What we do</span>
      <h2 class="section-title">Practical solutions for real businesses</h2>
      <p class="section-subtitle">
        We focus on a small set of things and do them well, instead of trying
        to be everything for everyone.
      </p>

      <div class="grid-2">
        {whatWeDo.map(({ icon, title, description }) => (
          <article class="card info-card">
            <span class="info-icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
            <h3 class="info-title">{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-label">How we work</span>
      <h2 class="section-title">A simple, predictable process</h2>
      <p class="section-subtitle">
        Clear steps, clear deliverables, clear pricing. Most projects follow
        this rhythm.
      </p>

      <ol class="process-list">
        {howWeWork.map(({ icon, title, description }) => (
          <li class="process-item">
            <span class="process-icon" aria-hidden="true"><Icon name={icon} size={16} /></span>
            <div>
              <h3 class="process-title">{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- What we build -->
  <section class="section">
    <div class="container">
      <span class="section-label">What we build</span>
      <h2 class="section-title">Project types we know well</h2>

      <div class="grid-2">
        {projectTypes.map(({ icon, title, description }) => (
          <article class="card info-card">
            <span class="info-icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
            <h3 class="info-title">{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why KOD -->
  <section class="section section--alt">
    <div class="container">
      <span class="section-label">Why KOD</span>
      <h2 class="section-title">What you can expect from us</h2>

      <div class="grid-3">
        {reasons.map(({ icon, title, description }) => (
          <article class="card info-card">
            <span class="info-icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
            <h3 class="info-title">{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title="Let's talk about your project"
    description="Share a short brief and we'll come back with concrete next steps."
    actions={[{ label: 'Start a project', href: '/contact', variant: 'primary' }]}
  />
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-alt);
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: rgba(108, 99, 255, 0.12);
    border: 1px solid rgba(108, 99, 255, 0.25);
    color: var(--color-primary-light);
  }

  .info-title {
    font-size: 1.05rem;
    color: var(--color-white);
  }

  .process-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem 2rem;
    margin-top: 1.5rem;
    padding: 0;
  }

  .process-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .process-icon {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(108, 99, 255, 0.15);
    color: var(--color-primary-light);
    border: 1px solid rgba(108, 99, 255, 0.3);
    margin-top: 0.15rem;
  }

  .process-title {
    font-size: 1rem;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .process-item p {
    font-size: 0.95rem;
  }
</style>
