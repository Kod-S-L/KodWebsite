---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CallToAction from '../components/CallToAction.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectsCarousel from '../components/ProjectsCarousel.astro';
import { projects, featuredProjects } from '../data/projects';
---

<BaseLayout
  title="Projects"
  description="A selection of websites, custom tools and automations built by KOD."
>
  <PageHeader
    label="Our work"
    title="Selected"
    highlight="projects"
    description="A mix of live work, ongoing builds and projects on the roadmap. New work is added as soon as it goes public."
  />

  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="section-label">Featured</span>
        <h2 class="section-title">Highlighted projects</h2>
        <p class="section-subtitle">
          A small selection we are happy to show. Use the arrows or swipe to browse.
        </p>

        <ProjectsCarousel projects={featuredProjects} ariaLabel="Featured KOD projects" />
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <span class="section-label">All projects</span>
      <h2 class="section-title">Every project at a glance</h2>

      <div class="projects-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <CallToAction
    title="Have something in mind?"
    description="If your project does not fit any of the categories above, we still want to hear about it."
    actions={[{ label: 'Get in touch', href: '/contact', variant: 'primary' }]}
  />
</BaseLayout>

<style>
  .section--alt {
    background: var(--color-bg-alt);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
