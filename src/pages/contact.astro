---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../data/icons';

interface ContactMethod {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

const contactMethods: ContactMethod[] = [
  {
    icon: 'mail',
    label: 'Email',
    value: 'hello@kodteam.dev',
    href: 'mailto:hello@kodteam.dev',
  },
  {
    icon: 'github',
    label: 'GitHub',
    value: 'github.com/Kod-S-L',
    href: 'https://github.com/Kod-S-L',
    external: true,
  },
];

// Public Formspree form endpoint. Public IDs by design — no secret here.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xvzlgelb';
---

<BaseLayout
  title="Contact"
  description="Tell us about your project. We review every request and reply within two working days."
>
  <PageHeader
    label="Contact"
    title="Tell us about"
    highlight="your project"
    description="Send us a short brief — what you need, when you need it, and any links we should look at. We reply within two working days."
  />

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="info-heading">What to include</h2>
        <p class="info-text">
          The more context we have, the faster we can suggest a useful next
          step. A short paragraph is plenty — no formal brief required.
        </p>
        <ul class="checklist">
          <li><Icon name="check" size={16} /> Goal of the project (what success looks like)</li>
          <li><Icon name="check" size={16} /> Type of project (website, tool, automation…)</li>
          <li><Icon name="check" size={16} /> Approximate budget and timeline if you have them</li>
          <li><Icon name="check" size={16} /> Links to anything relevant (current site, references)</li>
        </ul>

        <h2 class="info-heading info-heading--small">Direct channels</h2>
        <div class="contact-methods">
          {contactMethods.map(({ icon, label, value, href, external }) => (
            <a
              href={href}
              class="contact-method"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="method-icon" aria-hidden="true"><Icon name={icon} size={18} /></span>
              <div>
                <span class="method-label">{label}</span>
                <span class="method-value">{value}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="contact-form-wrapper">
        <form
          class="contact-form card"
          id="contactForm"
          method="POST"
          action={FORMSPREE_ENDPOINT}
          novalidate
        >
          <h2 class="form-title">Send a message</h2>
          <p class="form-intro">
            We review every request. We will reply with a clear next step,
            even if your project does not fit our scope.
          </p>

          <div class="form-group">
            <label for="name" class="form-label">Name <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              class="form-input"
              placeholder="Your name"
              required
              maxlength="100"
              autocomplete="name"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="you@example.com"
              required
              maxlength="120"
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="projectType" class="form-label">Project type</label>
            <select id="projectType" name="projectType" class="form-input">
              <option value="">Select an option (optional)</option>
              <option value="Website">Website</option>
              <option value="Landing page">Landing page</option>
              <option value="Custom software">Custom software</option>
              <option value="Automation">Automation</option>
              <option value="Maintenance">Maintenance / improvements</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Message <span aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              class="form-input form-textarea"
              placeholder="A short description of what you need."
              rows={6}
              required
              minlength="10"
              maxlength="2000"
            ></textarea>
          </div>

          <!-- Honeypot field. Real users do not see or fill this. -->
          <div class="hp-field" aria-hidden="true">
            <label for="company">Company</label>
            <input
              type="text"
              id="company"
              name="company"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <button type="submit" class="btn btn-primary submit-btn" id="submitBtn">
            <span class="submit-label">Send message</span>
            <Icon name="arrow-right" size={16} />
          </button>

          <p class="form-notice" id="formNotice" aria-live="polite" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }

  .info-heading {
    font-size: 1.2rem;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .info-heading--small {
    font-size: 1rem;
    margin-top: 2rem;
  }

  .info-text {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .checklist li :global(.icon) {
    color: var(--color-primary-light);
    margin-top: 0.2rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .contact-method:hover {
    border-color: var(--color-primary);
  }

  .method-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: rgba(108, 99, 255, 0.12);
    color: var(--color-primary-light);
    border: 1px solid rgba(108, 99, 255, 0.25);
  }

  .method-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.1rem;
  }

  .method-value {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 500;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-title {
    font-size: 1.3rem;
    color: var(--color-white);
  }

  .form-intro {
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-label span {
    color: var(--color-accent);
    margin-left: 0.15rem;
  }

  .form-input {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    color: var(--color-text);
    font-family: var(--font-sans);
    transition: border-color var(--transition), box-shadow var(--transition);
    width: 100%;
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
  }

  /* Honeypot — invisible to users, visible to crawlers/bots. */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-btn {
    align-self: flex-start;
  }

  .submit-btn[disabled] {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .submit-btn[data-state='loading'] .submit-label::after {
    content: '…';
  }

  .form-notice {
    font-size: 0.9rem;
    min-height: 1.2em;
  }

  .form-notice.success { color: #43e97b; }
  .form-notice.error   { color: var(--color-accent); }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xvzlgelb';
  const MIN_INTERVAL_MS = 8000;

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const notice = document.getElementById('formNotice');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector<HTMLElement>('.submit-label') ?? null;
  const defaultLabel = submitLabel?.textContent ?? 'Send message';

  let lastSubmitTs = 0;

  function setNotice(text: string, kind: 'success' | 'error' | '' = '') {
    if (!notice) return;
    notice.textContent = text;
    notice.className = kind ? `form-notice ${kind}` : 'form-notice';
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel) return;
    submitBtn.disabled = loading;
    submitBtn.dataset.state = loading ? 'loading' : '';
    submitLabel.textContent = loading ? 'Sending' : defaultLabel;
  }

  async function submitToFormspree(data: FormData): Promise<boolean> {
    try {
      const response = await fetch(FORMSPREE_ENDPOINT, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      return response.ok;
    } catch {
      return false;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const honeypot = String(data.get('company') ?? '').trim();

    if (honeypot) {
      // Silent success for bots — looks legitimate, sends nothing.
      setNotice('Thanks, your message has been sent.', 'success');
      form.reset();
      return;
    }

    if (!name || !email || !message) {
      setNotice('Please fill in name, email and message.', 'error');
      return;
    }

    if (message.length < 10) {
      setNotice('Please write a slightly longer message so we can help properly.', 'error');
      return;
    }

    const now = Date.now();
    if (now - lastSubmitTs < MIN_INTERVAL_MS) {
      setNotice('Please wait a moment before sending again.', 'error');
      return;
    }
    lastSubmitTs = now;

    setLoading(true);
    setNotice('Sending your message…');

    const ok = await submitToFormspree(data);
    setLoading(false);

    if (ok) {
      setNotice('Thanks! Your message has been sent. We will reply within two working days.', 'success');
      form.reset();
    } else {
      setNotice('Sorry, something went wrong. Please try again or email us directly at hello@kodteam.dev.', 'error');
    }
  });
</script>
