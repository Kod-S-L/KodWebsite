---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Home"
  description="KOD builds fast, reliable websites, custom software and business automations for teams that want to grow."
>
  <!-- Hero -->
  <section class="hero section">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="section-label">Digital solutions</span>
        <h1 class="hero-title">
          We build clear digital tools for
          <span class="highlight">growing businesses</span><span class="typing-bar" aria-hidden="true"></span>
        </h1>
        <p class="hero-description">
          Web development, custom software and small business automations —
          designed to be fast, reliable and easy to maintain.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Start a project</a>
          <a href="/projects" class="btn btn-outline">See our work</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="code-block">
          <div class="code-dots">
            <span></span><span></span><span></span>
          </div>
          <pre><code><span class="c-keyword">const</span> <span class="c-var">kod</span> = <span class="c-bracket">&#123;</span>
  focus<span class="c-punct">:</span> <span class="c-string">"clarity"</span><span class="c-punct">,</span>
  delivery<span class="c-punct">:</span> <span class="c-string">"reliable"</span><span class="c-punct">,</span>
  outcomes<span class="c-punct">:</span> <span class="c-bracket">[</span>
    <span class="c-string">"fast websites"</span><span class="c-punct">,</span>
    <span class="c-string">"custom tools"</span><span class="c-punct">,</span>
    <span class="c-string">"automations"</span><span class="c-punct">,</span>
  <span class="c-bracket">]</span><span class="c-punct">,</span>
<span class="c-bracket">&#125;</span><span class="c-punct">;</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section services-section">
    <div class="container">
      <span class="section-label">What we do</span>
      <h2 class="section-title">Services built around real needs</h2>
      <p class="section-subtitle">
        Every project is different. We listen first, propose what makes sense,
        and ship something you can actually use.
      </p>

      <div class="grid-2">
        {services.map(({ icon, title, description }) => (
          <ServiceCard icon={icon} title={title} description={description} />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title="Have a project in mind?"
    description="Tell us briefly what you need. We will get back within two working days with a clear next step."
    actions={[{ label: 'Start a project', href: '/contact', variant: 'primary' }]}
  />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding-top: calc(var(--nav-height) + 3rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    margin-bottom: 1.25rem;
    color: var(--color-white);
  }

  .hero-description {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Code Block Visual ── */
  .code-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .code-dots {
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .code-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .code-dots span:nth-child(1) { background: #ff5f56; }
  .code-dots span:nth-child(2) { background: #ffbd2e; }
  .code-dots span:nth-child(3) { background: #27c93f; }

  pre {
    padding: 1.5rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  .c-keyword { color: #c792ea; }
  .c-var     { color: #82aaff; }
  .c-string  { color: #c3e88d; }
  .c-num     { color: #f78c6c; }
  .c-punct   { color: var(--color-text-muted); }
  .c-bracket { color: #ffcb6b; }

  /* ── Services ── */
  .services-section {
    background: var(--color-bg-alt);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      display: none;
    }
  }
</style>
